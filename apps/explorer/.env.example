# Local explorer development: copy to apps/explorer/.env.local for next dev.

# ── Chain ─────────────────────────────────────────────────────────────────────
# CHAIN selects the server chain; NEXT_PUBLIC_CHAIN selects the client chain.
# Both must match: bnb | eth.
CHAIN=bnb
NEXT_PUBLIC_CHAIN=bnb

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults match `docker compose up -d postgres` (local development only).
DATABASE_URL=postgresql://altscan:altscan@localhost:5432/altscan
# CHAIN=eth reads ETH_DATABASE_URL instead of DATABASE_URL; set its own database URL.
# ETH_DATABASE_URL=
# The indexer creates the schema on first boot. An empty database has no tables
# until the indexer has run once against it; the explorer does not create them.
# Optional pool size (default 5) and statement timeout in ms (unset/0 disables it).
DB_POOL_SIZE=
DB_STATEMENT_TIMEOUT_MS=

# ── RPC endpoints ─────────────────────────────────────────────────────────────
# Free public BNB node. A comma-separated list is tried in order for failover.
BNB_RPC_URL=https://bsc-dataseed1.binance.org/
# For CHAIN=eth, use ETH_RPC_URL (also accepts a comma-separated list).
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# ── Optional Redis ────────────────────────────────────────────────────────────
# Compose does not publish Redis's port. Use a separately reachable Redis if needed.
# Without REDIS_URL, rate limits and caches fall back to per-process memory.
# REDIS_URL=redis://localhost:6379

# ── Optional enrichment APIs ──────────────────────────────────────────────────
# Moralis — https://moralis.io. Address history/assets and token holders.
# Without a key, or with MORALIS_DISABLED=true, enrichment is disabled and holders
# fall back to locally indexed estimates.
MORALIS_API_KEY=
MORALIS_DISABLED=
# Monthly CU ceiling per Redis ledger, or per process without Redis (default 2000000).
MORALIS_MONTHLY_CU_MAX=
# Per-feature call caps: history, holders and assets have separate buckets.
# Default CU costs per call (packages/providers/src/moralis.ts, CU_COST):
# history 150; balances 100; transfers 50; NFTs 50; holders 50; holder count 50.
# A holders lookup makes two calls: holders + holder count.
MORALIS_HISTORY_HOURLY_MAX=   # default 700
MORALIS_HISTORY_DAILY_MAX=    # default 5000
MORALIS_HOLDERS_HOURLY_MAX=   # default 400
MORALIS_HOLDERS_DAILY_MAX=    # default 2500
MORALIS_ASSETS_HOURLY_MAX=    # default 400
MORALIS_ASSETS_DAILY_MAX=     # default 2500
# CoinGecko demo key — https://www.coingecko.com/en/api. Unset uses the keyless tier.
COINGECKO_API_KEY=

# ── Optional admin access ──────────────────────────────────────────────────────
# Bearer token for /api/admin/*; unset, every admin route returns 401.
ADMIN_SECRET=

# ── Optional analytics and referral ads ────────────────────────────────────────
# Unset: no Google Analytics script or sponsored Binance placements.
GA_MEASUREMENT_ID=
BINANCE_REF_CODE=

# ── Optional CORS origin ───────────────────────────────────────────────────────
# Adds an allowed API CORS origin. The network switcher uses chainConfig.peerUrl.
NEXT_PUBLIC_PEER_URL=
