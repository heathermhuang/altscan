{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@altscan/db": ["../../packages/db/client.ts"],
      "@altscan/types": ["../../packages/types/index.ts"],
      // Same reason as @altscan/db above: these ship built (main/exports ->
      // ./dist) for the compiled-CJS indexer, but dist/ is gitignored and the
      // webs' Render build is `pnpm --filter @altscan/explorer build`, which
      // has no `^build` and never builds workspace deps. Without these aliases
      // that build dies on "Module not found: Can't resolve
      // '@altscan/explorer-core'". Next applies tsconfig paths to webpack, so
      // the webs compile these from source and never need dist at all.
      "@altscan/explorer-core": ["../../packages/explorer-core/src/index.ts"],
      "@altscan/explorer-core/format": ["../../packages/explorer-core/src/format.ts"],
      "@altscan/providers": ["../../packages/providers/src/index.ts"],
      // chain-config joined the built packages on 2026-08-07 (it shipped TS
      // source that the compiled CJS indexer require()d, which only ran under
      // Node's type-stripping). Without this entry the webs' build reaches
      // "Checking validity of types" and dies on "Cannot find module
      // '@altscan/chain-config' or its corresponding type declarations"
      // (lib/backfill-trigger.ts) — verified, not theorized. Only ESLint is
      // skipped during the build; type-checking is not.
      "@altscan/chain-config": ["../../packages/chain-config/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
