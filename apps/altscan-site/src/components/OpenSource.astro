---
import { GITHUB } from '../data/site';
import GitHubIcon from './GitHubIcon.astro';
// Commands mirror the README's "Running a specific chain" section — keep them runnable.
---
<section id="open-source" class="wrap sec" style="border-top:0;padding-top:0" aria-labelledby="oss-title">
  <div class="oss">
    <div>
      <p class="k">// free and open source</p>
      <h2 id="oss-title">One codebase.<br />Run it yourself.</h2>
      <p>AGPL-3.0. The engine behind bnbscan.com and ethscan.io is yours to read, fork and self-host. Each chain is one entry in <code>chain-config</code>; set <code>CHAIN</code> and run it.</p>
      <ul class="chips"><li>Next.js 15</li><li>Drizzle ORM</li><li>ethers v6</li><li>one schema</li><li>AGPL-3.0</li></ul>
      <div class="obtn"><a class="b1" href={GITHUB}><GitHubIcon size={15} /> Star on GitHub</a><a class="b2" href={`${GITHUB}#getting-started`}>Self-host guide <span aria-hidden="true">→</span></a></div>
    </div>
    <div class="term" data-term>
      <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
      <pre tabindex="0" aria-label="Commands to run one chain locally"><span class="ty"><span class="c"># clone and run one chain</span></span>
<span class="ty"><span class="ps">$</span> git clone {GITHUB}</span>
<span class="ty"><span class="ps">$</span> cd altscan && pnpm install</span>
<span class="ty"><span class="ps">$</span> <span class="y">CHAIN=bnb NEXT_PUBLIC_CHAIN=bnb</span> \</span>
<span class="ty">    pnpm --filter @altscan/explorer dev</span>
<span class="ty"><span class="ps">$</span> </span><span class="caret" aria-hidden="true"></span></pre>
    </div>
  </div>
</section>
