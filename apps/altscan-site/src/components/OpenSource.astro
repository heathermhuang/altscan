---
import { GITHUB } from '../data/site';
import GitHubIcon from './GitHubIcon.astro';
import { measure, type Pkg } from '../lib/codebase';

const { path, around } = measure();
const groups = [
  { label: 'the path a block takes →', pkgs: path },
  { label: 'around it', pkgs: around },
];
const sum = (pkgs: Pkg[]) => pkgs.reduce((s, p) => s + p.lines, 0);
const total = groups.reduce((s, g) => s + sum(g.pkgs), 0);
const fmt = (n: number) => n.toLocaleString('en-US');
const name = (p: string) => p.split('/')[1];
const tree = (p: string) => `${GITHUB}/tree/main/${p}`;
const built = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
// Mirrors the README's Docker quick start — keep it runnable.
const run = `git clone ${GITHUB}\ncd altscan && cp .env.docker.example .env\ndocker compose up -d`;
---
<section id="open-source" class="sec code" aria-labelledby="oss-title">
  <div class="wrap code-head rule">
    <div>
      <p class="k">// read the code · AGPL-3.0</p>
      <h2 id="oss-title">The whole engine,<br />to scale.</h2>
    </div>
    <div class="code-side">
      <p>All {fmt(total)} lines of TypeScript in its apps and packages are public: read them, fork them, run your own. Left to right, the code a block passes through, from its chain's entry in <code>chain-config</code> to the explorer page that shows it.</p>
      <div class="ctas"><a class="btn p" href={GITHUB}><GitHubIcon size={15} /> Star on GitHub</a><a class="btn g" href={`${GITHUB}/blob/main/docs/SELF_HOSTING.md`}>Self-host guide <span aria-hidden="true">→</span></a></div>
    </div>
  </div>
  <div class="cband">
    <div class="wrap cbar" aria-hidden="true">
      {groups.map((g) => (
        <div class="cgrp" style={`flex-grow:${sum(g.pkgs)}`}>
          <p class="th">{g.label}</p>
          <div class="ctiles">
            {g.pkgs.map((p) => (
              <span class="ct" style={`flex-grow:${p.lines}`}><i style={`height:${Math.round((p.tests / p.lines) * 100)}%`}></i><span class="lb">{p.path} · {fmt(p.lines)}</span></span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="wrap cap rule">
      <span>width = lines of TypeScript · fill = share that is tests · counted {built}</span>
      <a class="lnk" href={GITHUB}>browse the source ↗</a>
    </div>
    <div class="wrap ledger">
      {groups.map((g, i) => (
        <div class="lgrp">
          {i > 0 && <span class="lg" aria-hidden="true">{g.label}</span>}
          <ol aria-label={g.label.replace(' →', '')}>
            {g.pkgs.map((p) => <li><a href={tree(p.path)}>{name(p.path)}</a> {fmt(p.lines)}{p.path === 'apps/altscan-site' && ' (this page)'}</li>)}
          </ol>
        </div>
      ))}
    </div>
  </div>
  <div class="wrap run">
    <div>
      <p class="k">// or run your own</p>
      <p>Postgres, Redis, the indexer and an explorer, from the repository's compose file. No configuration to start.</p>
    </div>
    <div class="term">
      <pre tabindex="0" aria-label="Commands to run your own explorer">{run.split('\n').map((l) => <span class="cl"><span class="ps" aria-hidden="true">$ </span>{l}</span>)}</pre>
      <button class="copy" type="button" data-copy={run} hidden>copy</button>
    </div>
  </div>
</section>
