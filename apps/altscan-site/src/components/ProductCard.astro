---
import type { Product } from '../data/products';
interface Props { product: Product; }
const { product: p } = Astro.props;
const windowLabel = p.miniWindowS >= 120 ? `last ${p.miniWindowS / 60} min` : `last ${p.miniWindowS}s`;
---
<a class={`pan ${p.id}`} href={p.url} data-panel={p.id} data-window={p.miniWindowS}>
  <div class="ptop"><span class="logo" aria-hidden="true">{p.logoLetter}</span>
    <div><div class="pname">{p.brand}</div><div class="pdom">{p.domain} · {p.chain}</div></div>
  </div>
  <div class="mini" data-mini aria-hidden="true"></div>
  <dl class="pst">
    <div><dt>latest block</dt><dd data-p-latest>—</dd></div>
    <div><dt>{windowLabel}</dt><dd data-p-count>—</dd></div>
    <div><dt>status</dt><dd data-p-status>—</dd></div>
  </dl>
  <span class="pgo">Open explorer <span aria-hidden="true">→</span></span>
</a>
