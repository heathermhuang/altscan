---
import { products } from '../data/products';
---
<header class="wrap hero">
  <p class="k">// open-source · multi-chain · block explorer platform</p>
  <h1><span class="ln">The alternative explorer,</span><span class="ln">for every chain.</span></h1>
  <div class="hero-row">
    <p class="lede">One open-source engine, one indexer, one schema, powering independent explorers. Below: the blocks it is indexing right now.</p>
    <div class="ctas">
      {products.map((p, i) => (
        <a class={`btn ${i === 0 ? 'p' : 'g'}`} href={p.url}>Open {p.brand} <span aria-hidden="true">↗</span></a>
      ))}
    </div>
  </div>
</header>
