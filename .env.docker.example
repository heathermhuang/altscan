# Altscan self-hosting configuration.
#
#   cp .env.docker.example .env && docker compose up -d
#
# Every value below has a working default — `docker compose up` runs with an empty
# .env. Set things here only to override.

# ── Chain ─────────────────────────────────────────────────────────────────────
# bnb | eth. Changing this requires a rebuild (`docker compose up -d --build`):
# Next inlines the chain into the client bundle at build time.
CHAIN=bnb

# ── RPC endpoints ─────────────────────────────────────────────────────────────
# The defaults are free public nodes — fine for evaluation, rate-limited under real
# use. For anything serious use a dedicated provider (Ankr, Chainstack, QuickNode…).
BNB_RPC_URL=https://bsc-dataseed1.binance.org/
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# ── Where to start indexing ───────────────────────────────────────────────────
# "tip" resolves to the current chain head at boot, minus START_BLOCK_LOOKBACK.
# This is almost always what you want: the built-in defaults are block 38,000,000
# for BNB and block 0 for ETH, either of which means days of indexing before the
# explorer shows current data.
#
# To start from a specific height instead, put a block number here.
START_BLOCK=tip
START_BLOCK_LOOKBACK=1000

# ── Storage ───────────────────────────────────────────────────────────────────
# Transaction bodies older than this are pruned. Raise for more history, but note
# BNB Chain writes roughly 12–15 GB per month at full retention; check free disk
# before increasing.
RETENTION_DAYS=7

# ── Ports ─────────────────────────────────────────────────────────────────────
EXPLORER_PORT=3000
POSTGRES_PORT=5432

# ── Database ──────────────────────────────────────────────────────────────────
# Change these before exposing anything to a network.
POSTGRES_USER=altscan
POSTGRES_PASSWORD=altscan
POSTGRES_DB=altscan

# ── Performance ───────────────────────────────────────────────────────────────
# Raise INDEX_CONCURRENCY to index faster, if your RPC provider allows the rate.
# Keep INDEXER_DB_POOL_SIZE >= INDEX_CONCURRENCY or workers block on connections.
INDEX_CONCURRENCY=4
INDEXER_DB_POOL_SIZE=8
EXPLORER_DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=15000

# ── Optional third-party enrichment ───────────────────────────────────────────
# Moralis (https://moralis.io, free tier available) powers full address transaction
# history and token holder lists beyond your local retention window. WITHOUT IT the
# explorer still works, but address history is limited to locally indexed blocks and
# holder counts fall back to an estimate. See docs/SELF_HOSTING.md.
MORALIS_API_KEY=

# CoinGecko demo key — optional; absent falls back to the keyless public tier.
COINGECKO_API_KEY=
