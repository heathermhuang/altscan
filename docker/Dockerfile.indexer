# syntax=docker/dockerfile:1
#
# Altscan indexer — one image serves any chain; CHAIN selects at runtime.
#
#   docker build -f docker/Dockerfile.indexer -t altscan-indexer .
#
# The indexer creates its own schema on boot (apps/indexer/src/ensure-schema.ts),
# so there is no separate migration step for a fresh database.

FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ── Build ────────────────────────────────────────────────────────────────────
FROM base AS build

# node-gyp toolchain for any dependency without a prebuilt musl binary
RUN apk add --no-cache python3 make g++ libc6-compat

COPY . .
RUN pnpm install --frozen-lockfile

# Every workspace package the indexer imports emits dist/ that is gitignored, so
# each one must be built here or the module is simply absent in the image.
# @altscan/explorer-core and @altscan/providers are the easy ones to miss — the
# backfill worker only require()s providers at runtime.
# Order matters: chain-config and db before the indexer, and explorer-core BEFORE
# providers — providers value-imports it (packages/providers/src/moralis.ts).
RUN pnpm --filter @altscan/chain-config build \
 && pnpm --filter @altscan/explorer-core build \
 && pnpm --filter @altscan/providers build \
 && pnpm --filter @altscan/db build \
 && pnpm --filter @altscan/indexer build

# Assert the packaging at BUILD time instead of discovering it at boot. tsc runs
# with noEmitOnError:false, so it EMITS a dist/index.js even when it errors on a
# missing package — restore a `|| true` on the indexer's build and a broken image
# ships silently, failing only when the backfill worker require()s providers.
# This asserts the artifact exists, parses, and that every workspace package the
# runtime require()s actually resolves from the indexer's own directory.
RUN test -s apps/indexer/dist/index.js \
 && node --check apps/indexer/dist/index.js \
 && test -s packages/providers/dist/index.js \
 && test -s packages/explorer-core/dist/index.js \
 && cd apps/indexer \
 && node -e "require('@altscan/providers');console.log('[build-check] @altscan/providers loads (transitively proves explorer-core)')"

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production

RUN apk add --no-cache libc6-compat \
 && addgroup -S altscan && adduser -S altscan -G altscan

COPY --from=build --chown=altscan:altscan /app /app
COPY --chown=altscan:altscan docker/indexer-entrypoint.sh /usr/local/bin/altscan-entrypoint
RUN chmod +x /usr/local/bin/altscan-entrypoint

USER altscan
WORKDIR /app/apps/indexer

# CHAIN, the chain's DB env var, REDIS_URL and the RPC URL are supplied at run time.
# The entrypoint resolves START_BLOCK=tip to a live block number before starting.
ENTRYPOINT ["/usr/local/bin/altscan-entrypoint"]
CMD ["node", "dist/index.js"]
